{
  "name": "@webywz/eval-smoke",
  "version": "0.1.0",
  "description": "One-minute smoke evals for prompts and models — catch regressions before they ship.",
  "type": "module",
  "bin": {
    "eval-smoke": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node dist/cli.js examples/suite.yaml --mock",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "eval",
    "llm",
    "prompt",
    "smoke-test",
    "openai",
    "anthropic",
    "cli"
  ],
  "author": "webywz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webywz/eval-smoke.git"
  },
  "bugs": {
    "url": "https://github.com/webywz/eval-smoke/issues"
  },
  "homepage": "https://github.com/webywz/eval-smoke#readme",
  "dependencies": {
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
